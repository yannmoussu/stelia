{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Consultation",
  "description": "Schema for an orthoptic consultation data structure",
  "type": "object",
  "additionalProperties": false,
  "required": ["patient", "contexte", "bilan_sensoriel", "bilan_optomoteur", "conclusion"],
  "properties": {
    "patient": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nom": { "type": ["string", "null"] },
        "prenom": { "type": ["string", "null"] },
        "date_naissance": { "type": ["string", "null"] }
      }
    },
    "contexte": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "motif_demande": { "type": ["string", "null"] },
        "suivi_ophtalmologique": { "type": ["string", "null"] },
        "correction_visuelle": { "type": ["string", "null"] },
        "signes_fonctionnels": { "type": ["string", "null"] }
      }
    },
    "bilan_sensoriel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "acuite_visuelle": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "vision_lointaine": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "od": { "type": ["string", "null"] },
                "og": { "type": ["string", "null"] }
              }
            },
            "vision_proche": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "od": { "type": ["string", "null"] },
                "og": { "type": ["string", "null"] }
              }
            },
            "correction": { "type": ["string", "null"] }
          }
        },
        "capacites_fusionnelles": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "convergence": { "type": ["string", "null"] },
            "divergence": { "type": ["string", "null"] },
            "convergence_proche": { "type": ["string", "null"] },
            "divergence_proche": { "type": ["string", "null"] },
            "valeur_brute": { "type": ["string", "null"] }
          }
        },
        "acuite_stereoscopique": { "type": ["string", "null"] },
        "conclusion": { "type": ["string", "null"] }
      }
    },
    "bilan_optomoteur": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "parallellisme": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pres": { "type": ["string", "null"] },
            "loin": { "type": ["string", "null"] }
          }
        },
        "mesure_angle_prismes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "vision_proche": { "type": ["string", "null"] },
            "vision_lointaine": { "type": ["string", "null"] },
            "valeur_brute": { "type": ["string", "null"] }
          }
        },
        "motilite": { "type": ["string", "null"] },
        "motricite_conjuguee": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fixation": { "type": ["string", "null"] },
            "poursuite": { "type": ["string", "null"] },
            "saccades": { "type": ["string", "null"] }
          }
        },
        "ppc": { "type": ["string", "null"] },
        "conclusion": { "type": ["string", "null"] }
      }
    },
    "conclusion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "synthese_clinique": { "type": ["string", "null"] },
        "prise_en_charge": { "type": ["string", "null"] },
        "recommandations": { "type": ["string", "null"] },
        "suivi": { "type": ["string", "null"] }
      }
    }
  }
}
