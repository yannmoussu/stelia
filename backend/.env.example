# Copier dans backend/.env. Aucun secret de démonstration.
STELIA_USERNAME=
STELIA_PASSWORD_HASH=
# Alternative multi-comptes : tableau JSON d'objets {id:UUID,username,passwordHash}.
# STELIA_USERS_JSON=
HOST=127.0.0.1
PORT=3000
SQLITE_PATH=./data/stelia.sqlite
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# NODE_ENV=production active les cookies Secure (HTTPS requis).
# STELIA_SECURE_COOKIES=true

# Tous les trois requis pour activer l'IA ; ne mettre aucune clé dans le frontend.
# AI_ENDPOINT=https://votre-service.example/structure
# AI_API_KEY=
# AI_MODEL=
AI_TIMEOUT_MS=30000
